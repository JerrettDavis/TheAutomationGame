<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Stride.Engine" Version="4.4.1" />
    <PackageVersion Include="Stride.Core.Assets.CompilerApp" Version="4.3.0.2507" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.11.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Transitive pin: SSH.NET 2023.0.1 (pulled in by Stride.Core.Assets.CompilerApp) has a known high-severity vulnerability (GHSA-q939-rpr3-3284), fixed in 2024.1.0+ -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Transitive pin: SixLabors.ImageSharp (pulled in by Stride) has high-severity advisories (GHSA-gwg2-r3hj-4w44, GHSA-j3p4-wp97-rph4, GHSA-wmxv-xphr-5c9g, GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w), fixed in 4.1.2 -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
